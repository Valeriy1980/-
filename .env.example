NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI-двигун контенту (stage 6: npm run scrape:enrich)
# Ключ Anthropic API — потрібен лише для генерації контенту, не для сайту.
ANTHROPIC_API_KEY=
# Необов'язково: модель і глибина. Дефолт — claude-opus-4-8 / low.
# Для великого каталогу можна здешевити: ENRICH_MODEL=claude-haiku-4-5
# ENRICH_MODEL=claude-opus-4-8
# ENRICH_EFFORT=low
# ENRICH_CONCURRENCY=4
